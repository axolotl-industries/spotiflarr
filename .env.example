# Bootstrap config — copy to .env and fill in. Everything here can also be
# changed later via the web UI at http://<host>:8182/settings (which writes
# to /data/config.json and overrides these env values on next cycle).

# Lidarr (required for first run)
LIDARR_URL=http://192.168.1.34:8686
LIDARR_API_KEY=

# Path Lidarr's container or LXC sees for the /output volume mount. The
# orchestrator passes this to Lidarr's DownloadedAlbumsScan.
LIDARR_OUTPUT_PATH=/mnt/bigboi/media/downloads/music/spotiflac

# Optional ntfy notifications on import successes / repeated failures
NTFY_URL=https://ntfy.geoffflix.uk
NTFY_TOKEN=
NTFY_TOPIC=docker-alerts
